# ============================================================
#  AirRadar AI — пример конфигурации
#  Скопируй этот файл в `.env` и заполни своими значениями.
#  `.env` в git не попадает (см. .gitignore).
# ============================================================

# --- Telegram User API (чтение исходных каналов через Telethon) ---
# Получить на https://my.telegram.org → API development tools
TG_API_ID=123456
TG_API_HASH=replace_me_with_api_hash

# Имя сессии Telethon (создаст файл <SESSION_NAME>.session)
SESSION_NAME=airradar

# --- Telegram Bot API (публикация в целевой канал) ---
# Создать бота через @BotFather и добавить его админом в TARGET_CHANNEL
BOT_TOKEN=123456:replace_me_with_bot_token

# Целевой канал, куда публикуются обработанные сообщения.
# Форматы: @username  ИЛИ  -1001234567890 (числовой ID супергруппы/канала)
TARGET_CHANNEL=@my_alerts_channel

# Исходные каналы для мониторинга (через запятую).
# Форматы те же: @username или -100...
SOURCE_CHANNELS=@channel_one,@channel_two,-1009876543210

# --- Локальный ИИ (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Рантайм-настройки ---
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Окно дедупликации в секундах (повторы внутри окна игнорируются)
DEDUP_TTL=60

# Таймаут HTTP-запросов (Ollama + Bot API), в секундах
HTTP_TIMEOUT=30

# Интервал фонового healthcheck-пинга Ollama, в секундах
HEALTHCHECK_INTERVAL=300
