# ============================================================
#  AirRadar AI — пример конфигурации
#  Скопируй этот файл в `.env` и заполни своими значениями.
#  `.env` в git не попадает (см. .gitignore).
# ============================================================

# --- Telegram User API (чтение исходных каналов через Telethon) ---
# Получить на https://my.telegram.org → API development tools
TG_API_ID=123456
TG_API_HASH=replace_me_with_api_hash

# Имя сессии Telethon (создаст файл <SESSION_NAME>.session)
SESSION_NAME=airradar

# --- Telegram Bot API (публикация в целевой канал) ---
# Создать бота через @BotFather и добавить его админом в TARGET_CHANNEL
BOT_TOKEN=123456:replace_me_with_bot_token

# Целевой канал, куда публикуются обработанные сообщения.
# Форматы: @username  ИЛИ  -1001234567890 (числовой ID супергруппы/канала)
TARGET_CHANNEL=@my_alerts_channel

# Telegram user id администратора (кому доступно меню бота в личке).
# Узнать свой id: перешли любое сообщение боту @userinfobot.
# 0 = меню отключено (бот только публикует, без кнопок).
ADMIN_ID=0

# Путь к SQLite-журналу (накапливает угрозы для статистики и ETA)
DB_PATH=airradar.db

# Исходные каналы для мониторинга (через запятую).
# Форматы те же: @username или -100...
# Примечание (продакшн): на сервере здесь указан мониторинговый канал
# @nebo_raketa — добавить его в этот список на сервере, не в коде.
#
# Известные мониторинговые каналы Украины (проверь каждый перед добавлением,
# User-аккаунт должен быть подписан на них):
#   @nebo_raketa        — «Повітряні сили / Небо» сводки (общенациональный)
#   @unw_mil            — оперативные сводки (области)
#   @enemy_aat          — БпЛА/ракеты по областям, таблицы целей
#   @air_alert_tbilisi  — дубли тревог по областям
#   @kyiv_monitor       — Киев и область
#   @sumy_liketop       — Сумщина (пуски БпЛА)
#   @chernihiv_op       — Чернігівщина
#   @kharkiv_monitor    — Харківщина
#   @dnipro_ann         — Дніпропетровщина
#   @odesa_live         — Одещина
# Рекомендация: 6–12 региональных + 1–2 общенациональных. Чем шире список,
# тем полнее статистика волн и точнее прогноз отбоя.
SOURCE_CHANNELS=@channel_one,@channel_two,-1009876543210

# Публиковать в канал только угрозы «уже летят» (стадия imminent).
# 1 = да (по умолчанию): посты без глагола движения пишутся в БД и карту,
#     но не публикуются. Отбой проходит всегда.
# 0 = прежнее поведение: imminent + unknown публикуются.
IN_FLIGHT_ONLY=1

# Проактивное предупреждение «можлива нова тривога» (статистика волн).
# После отбоя, когда по истории региона (медіана «відбій → нова тривога»,
# нужно 3+ завершённых эпизода) подходит срок новой волны, подписчики
# региона получают одно предупреждение на эпизод. Ночной режим фильтрует
# получателей так же, как обычные алерты.
# 1 = включено (по умолчанию), 0 = выключить.
PRE_WAVE_NOTICE=1

# Проактивный countdown отбоя: во время тревоги, когда по статистике региона
# (медіана «останній політ → відбій», нужно 3+ эпизода) до отбоя остаётся
# ~25 минут, подписчики получают «відбій орієнтовно за ~N хв» с объяснением.
# Одно сообщение на эпизод полёта. Ночной режим не глушит его полностью —
# это управляющее сообщение без фильтра типов.
# 1 = включено (по умолчанию), 0 = выключить.
STANDDOWN_NOTICE=1

# Гард ложных критичных угроз: пост CRITICAL-класса (балістика, крилаті
# ракети, КАБ…) от ОДНОГО источника не публикуется в канал мгновенно —
# ждёт подтверждения (2+ независимых источника или официальный канал).
# В БД и на карту пост пишется сразу. Защита от рутины «загроза балістики»
# от одного мониторингового канала.
# 1 = включено (по умолчанию), 0 = прежний мгновенный CRITICAL-байпас.
CRITICAL_NEEDS_CONFIRMATION=1

# Окно агрегации алертов в секундах: сообщения одного инцидента (регион+тип
# оружия) склеиваются в один пост. Минимум 5. Критичные классы (баллистика,
# ракеты), отбой и материальные обновления публикуются мгновенно, без ожидания.
AGGREGATE_WINDOW_SEC=35

# Наш канал для пассивной рекламы: в каждом посте строка «📡 Джерело:
# AirRadar AI» делается кликабельной ссылкой на этот URL. Пусто = без ссылки.
PROMO_CHANNEL_URL=https://t.me/AirRadarAI
# --- Какой ИИ-бэкенд использовать ---
# ollama = локальная Ollama (тяжёлая, нужно 4–8 ГБ RAM под модель; для мощного компа/VPS)
# groq  = облачный Groq API (лёгкий, для дешёвого VPS 24/7; отвечает ~0.2 сек)
LLM_BACKEND=ollama

# --- Локальный ИИ (Ollama) — используется при LLM_BACKEND=ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Облачный ИИ (Groq) — используется при LLM_BACKEND=groq ---
# Бесплатный ключ: https://console.groq.com/keys  (нужна только регистрация)
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai
# Модель Groq. Актуальный список: https://console.groq.com/docs/models
# Быстрый бесплатный вариант — llama-3.1-8b-instant.
GROQ_MODEL=llama-3.1-8b-instant

# --- Рантайм-настройки ---
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Окно дедупликации в секундах (повторы внутри окна игнорируются)
DEDUP_TTL=60

# Таймаут HTTP-запросов (Ollama + Bot API), в секундах
HTTP_TIMEOUT=30

# Интервал фонового healthcheck-пинга Ollama, в секундах
HEALTHCHECK_INTERVAL=300
