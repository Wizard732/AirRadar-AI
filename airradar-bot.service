[Unit]
Description=AirRadar Telegram bot
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/airradar
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/airradar/.venv/bin/python main.py
Restart=always
RestartSec=10
# Код 2 = сессия Telegram слетела: рестарты не помогут, нужен ручной вход.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
