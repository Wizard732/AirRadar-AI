[Unit]
Description=AirRadar recent Telegram recovery synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/airradar
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/cp /opt/airradar/airradar.session /tmp/airradar_history.session
ExecStart=/usr/bin/flock -n /tmp/airradar-history-sync.lock /opt/airradar/.venv/bin/python sync_history.py --reconcile-days 0 --limit 100
