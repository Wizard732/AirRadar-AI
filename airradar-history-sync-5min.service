[Unit]
Description=AirRadar recent Telegram recovery synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/AirRadar-AI
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock -n /tmp/airradar-history-sync.lock /root/AirRadar-AI/.venv/bin/python sync_history.py --reconcile-days 0
