[Unit]
Description=AirRadar recent Telegram recovery synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/AirRadar-AI
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/cp /root/AirRadar-AI/airradar.session /tmp/airradar_history.session
ExecStart=/usr/bin/flock -n /tmp/airradar-history-sync.lock /root/AirRadar-AI/.venv/bin/python sync_history.py --reconcile-days 1 --limit 500
